# ==========================================
# MakeMyMarriage — Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

VITE_API_BASE_URL=http://localhost:5000/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/makemymarriage?schema=public
REDIS_URL=redis://localhost:6379

SESSION_SECRET=make-my-marriage-super-secure-session-secret-change-in-prod
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=MakeMyMarriage <invitations@makemymarriage.com>

SSE_HEARTBEAT_INTERVAL_MS=30000
