generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeddingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  DELETED
}

enum WeddingVisibility {
  PRIVATE
  PUBLIC
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  INVITED_GUESTS_ONLY
  PRIVATE
}

enum GuestSide {
  BRIDE
  GROOM
  BOTH
  NEUTRAL
}

enum GuestEventInvitationStatus {
  NOT_INVITED
  INVITED
  REVOKED
}

enum GuestEventAccessStatus {
  ALLOWED
  BLOCKED
}

enum InvitationStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  OPENED
  REVOKED
  FAILED
}

enum RsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum PhotoVisibility {
  PUBLIC
  PRIVATE
  EVENT_ONLY
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaProvider {
  CLOUDINARY
  S3
  R2
  OTHER
}

enum CheckInSource {
  QR
  MANUAL
}

enum LiveStreamProvider {
  YOUTUBE
  VIMEO
  CUSTOM
  OTHER
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  DISABLED
}

enum WebsiteSectionType {
  HERO
  COUPLE_STORY
  EVENTS
  VENUE
  COUNTDOWN
  GALLERY
  LIVE_STREAM
  RSVP
  FOOTER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String          @map("password_hash")
  name              String          @db.VarChar(150)
  preferredLanguage String          @default("en") @map("preferred_language") @db.VarChar(10)
  emailVerifiedAt   DateTime?       @map("email_verified_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  ownedWeddings     Wedding[]       @relation("WeddingOwner")
  memberships       WeddingMember[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  uploadedPhotos    Photo[]         @relation("UserUploadedPhotos")
  checkInsPerformed GuestEntry[]    @relation("CheckedInByUser")
  notifications     Notification[]  @relation("UserNotifications")
  activities        Activity[]      @relation("UserActivities")

  @@map("users")
}

model Role {
  id          String          @id @default(uuid())
  name        String          @unique @db.VarChar(50)
  description String?         @db.Text
  permissions Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  memberships WeddingMember[]

  @@map("roles")
}

model WeddingMember {
  id        String           @id @default(uuid())
  weddingId String           @map("wedding_id")
  userId    String           @map("user_id")
  roleId    String           @map("role_id")
  status    MembershipStatus @default(INVITED)
  invitedAt DateTime?        @map("invited_at")
  joinedAt  DateTime?        @map("joined_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  wedding   Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id])

  @@unique([weddingId, userId])
  @@index([weddingId])
  @@index([userId])
  @@map("wedding_members")
}

model Wedding {
  id              String            @id @default(uuid())
  ownerId         String            @map("owner_id")
  name            String            @db.VarChar(200)
  slug            String            @unique @db.VarChar(200)
  description     String?           @db.Text
  weddingDate     DateTime?         @map("wedding_date") @db.Date
  timezone        String            @default("Asia/Kolkata") @db.VarChar(100)
  countryCode     String            @default("IN") @map("country_code") @db.Char(2)
  defaultLanguage String            @default("en") @map("default_language") @db.VarChar(10)
  status          WeddingStatus     @default(DRAFT)
  visibility      WeddingVisibility @default(PRIVATE)
  settings        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  owner           User              @relation("WeddingOwner", fields: [ownerId], references: [id])
  members         WeddingMember[]
  venues          Venue[]
  events          Event[]
  guests          Guest[]
  guestCategories GuestCategory[]
  invitations     Invitation[]
  rsvps           RSVP[]
  tasks           Task[]
  photos          Photo[]
  guestEntries    GuestEntry[]
  liveStreams     LiveStream[]
  website         WeddingWebsite?
  notifications   Notification[]
  activities      Activity[]

  @@index([ownerId])
  @@index([slug])
  @@map("weddings")
}

model Venue {
  id           String    @id @default(uuid())
  weddingId    String    @map("wedding_id")
  name         String    @db.VarChar(200)
  addressLine1 String    @map("address_line_1") @db.Text
  addressLine2 String?   @map("address_line_2") @db.Text
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  postalCode   String    @map("postal_code") @db.VarChar(30)
  countryCode  String    @default("IN") @map("country_code") @db.Char(2)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  mapsUrl      String?   @map("maps_url") @db.Text
  contactPhone String?   @map("contact_phone") @db.VarChar(30)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  wedding      Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([weddingId])
  @@map("venues")
}

model Event {
  id          String          @id @default(uuid())
  weddingId   String          @map("wedding_id")
  venueId     String?         @map("venue_id")
  name        String          @db.VarChar(200)
  description String?         @db.Text
  startAt     DateTime        @map("start_at")
  endAt       DateTime        @map("end_at")
  timezone    String          @default("Asia/Kolkata") @db.VarChar(100)
  status      EventStatus     @default(SCHEDULED)
  visibility  EventVisibility @default(PUBLIC)
  settings    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  wedding      Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  venue        Venue?          @relation(fields: [venueId], references: [id])
  guestEvents  GuestEvent[]
  rsvps        RSVP[]
  tasks        Task[]
  photos       Photo[]
  guestEntries GuestEntry[]
  liveStreams  LiveStream[]

  @@index([weddingId])
  @@index([venueId])
  @@map("events")
}

model GuestCategory {
  id        String   @id @default(uuid())
  weddingId String   @map("wedding_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guests    Guest[]

  @@unique([weddingId, name])
  @@index([weddingId])
  @@map("guest_categories")
}

model Guest {
  id          String     @id @default(uuid())
  weddingId   String     @map("wedding_id")
  categoryId  String?    @map("category_id")
  firstName   String     @map("first_name") @db.VarChar(100)
  lastName    String?    @map("last_name") @db.VarChar(100)
  displayName String     @map("display_name") @db.VarChar(200)
  email       String?    @db.VarChar(255)
  phone       String?    @db.VarChar(30)
  side        GuestSide  @default(NEUTRAL)
  notes       String?    @db.Text
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  wedding        Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  category       GuestCategory? @relation(fields: [categoryId], references: [id])
  guestEvents    GuestEvent[]
  invitations    Invitation[]
  rsvps          RSVP[]
  uploadedPhotos Photo[]        @relation("GuestUploadedPhotos")
  guestEntries   GuestEntry[]
  notifications  Notification[] @relation("GuestNotifications")
  activities     Activity[]     @relation("GuestActivities")

  @@index([weddingId])
  @@index([categoryId])
  @@map("guests")
}

model GuestEvent {
  id               String                     @id @default(uuid())
  guestId          String                     @map("guest_id")
  eventId          String                     @map("event_id")
  invitationStatus GuestEventInvitationStatus @default(INVITED) @map("invitation_status")
  accessStatus     GuestEventAccessStatus     @default(ALLOWED) @map("access_status")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  guest            Guest                      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event            Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@index([guestId])
  @@index([eventId])
  @@map("guest_events")
}

model Invitation {
  id          String            @id @default(uuid())
  weddingId   String            @map("wedding_id")
  guestId     String            @map("guest_id")
  templateId  String?           @map("template_id")
  status      InvitationStatus  @default(DRAFT)
  sentAt      DateTime?         @map("sent_at")
  deliveredAt DateTime?         @map("delivered_at")
  openedAt    DateTime?         @map("opened_at")
  lastSentAt  DateTime?         @map("last_sent_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  wedding     Wedding           @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest       Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  access      InvitationAccess?

  @@index([weddingId])
  @@index([guestId])
  @@map("invitations")
}

model InvitationAccess {
  id           String     @id @default(uuid())
  invitationId String     @unique @map("invitation_id")
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime?  @map("expires_at")
  lastUsedAt   DateTime?  @map("last_used_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("invitation_access")
}

model RSVP {
  id                     String     @id @default(uuid())
  weddingId              String     @map("wedding_id")
  guestId                String     @map("guest_id")
  eventId                String     @map("event_id")
  status                 RsvpStatus @default(PENDING)
  attendeeCount          Int        @default(1) @map("attendee_count") @db.SmallInt
  foodPreference         String?    @map("food_preference") @db.VarChar(100)
  accommodationRequired  Boolean    @default(false) @map("accommodation_required")
  transportationRequired Boolean    @default(false) @map("transportation_required")
  message                String?    @db.Text
  respondedAt            DateTime?  @map("responded_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  wedding                Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest                  Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event                  Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@index([weddingId])
  @@index([eventId])
  @@map("rsvps")
}

model Task {
  id          String       @id @default(uuid())
  weddingId   String       @map("wedding_id")
  eventId     String?      @map("event_id")
  title       String       @db.VarChar(200)
  description String?      @db.Text
  assigneeId  String?      @map("assignee_id")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueAt       DateTime?    @map("due_at")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id])
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([weddingId])
  @@index([eventId])
  @@index([assigneeId])
  @@map("tasks")
}

model MediaAsset {
  id               String        @id @default(uuid())
  provider         MediaProvider @default(CLOUDINARY)
  providerAssetId  String        @map("provider_asset_id") @db.VarChar(255)
  publicId         String        @map("public_id") @db.VarChar(255)
  secureUrl        String        @map("secure_url") @db.Text
  resourceType     String        @default("image") @map("resource_type") @db.VarChar(50)
  format           String        @db.VarChar(20)
  width            Int?
  height           Int?
  bytes            BigInt?
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  photos           Photo[]

  @@map("media_assets")
}

model Photo {
  id                  String                @id @default(uuid())
  weddingId           String                @map("wedding_id")
  eventId             String?               @map("event_id")
  uploadedByUserId    String?               @map("uploaded_by_user_id")
  uploadedByGuestId   String?               @map("uploaded_by_guest_id")
  mediaAssetId        String                @map("media_asset_id")
  visibility          PhotoVisibility       @default(PUBLIC)
  moderationStatus    PhotoModerationStatus @default(PENDING) @map("moderation_status")
  caption             String?               @db.Text
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")

  wedding             Wedding               @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event               Event?                @relation(fields: [eventId], references: [id])
  uploadedByUser      User?                 @relation("UserUploadedPhotos", fields: [uploadedByUserId], references: [id])
  uploadedByGuest     Guest?                @relation("GuestUploadedPhotos", fields: [uploadedByGuestId], references: [id])
  mediaAsset          MediaAsset            @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([eventId])
  @@map("photos")
}

model GuestEntry {
  id            String        @id @default(uuid())
  weddingId     String        @map("wedding_id")
  eventId       String        @map("event_id")
  guestId       String        @map("guest_id")
  checkedInById String        @map("checked_in_by_id")
  checkedInAt   DateTime      @default(now()) @map("checked_in_at")
  source        CheckInSource @default(QR)
  metadata      Json          @default("{}")

  wedding       Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest         Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkedInBy   User          @relation("CheckedInByUser", fields: [checkedInById], references: [id])

  @@unique([guestId, eventId])
  @@index([weddingId])
  @@index([eventId])
  @@map("guest_entries")
}

model LiveStream {
  id         String             @id @default(uuid())
  weddingId  String             @map("wedding_id")
  eventId    String             @map("event_id")
  provider   LiveStreamProvider @default(YOUTUBE)
  streamUrl  String             @map("stream_url") @db.Text
  embedUrl   String?            @map("embed_url") @db.Text
  status     LiveStreamStatus   @default(SCHEDULED)
  title      String             @db.VarChar(200)
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  wedding    Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([eventId])
  @@map("live_streams")
}

model WeddingWebsite {
  id          String           @id @default(uuid())
  weddingId   String           @unique @map("wedding_id")
  slug        String           @unique @db.VarChar(200)
  themeId     String?          @map("theme_id")
  settings    Json             @default("{}")
  seo         Json             @default("{}")
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  wedding     Wedding          @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  sections    WebsiteSection[]

  @@index([slug])
  @@map("wedding_websites")
}

model WebsiteSection {
  id               String             @id @default(uuid())
  weddingWebsiteId String             @map("wedding_website_id")
  sectionType      WebsiteSectionType @map("section_type")
  position         Int                @default(0)
  isEnabled        Boolean            @default(true) @map("is_enabled")
  content          Json               @default("{}")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  website          WeddingWebsite     @relation(fields: [weddingWebsiteId], references: [id], onDelete: Cascade)

  @@index([weddingWebsiteId])
  @@map("website_sections")
}

model Notification {
  id               String              @id @default(uuid())
  weddingId        String              @map("wedding_id")
  recipientUserId  String?             @map("recipient_user_id")
  recipientGuestId String?             @map("recipient_guest_id")
  type             String              @db.VarChar(100)
  channel          NotificationChannel @default(EMAIL)
  status           NotificationStatus  @default(PENDING)
  subject          String?             @db.Text
  payload          Json                @default("{}")
  scheduledAt      DateTime?           @map("scheduled_at")
  sentAt           DateTime?           @map("sent_at")
  failedAt         DateTime?           @map("failed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  wedding          Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  recipientUser    User?               @relation("UserNotifications", fields: [recipientUserId], references: [id])
  recipientGuest   Guest?              @relation("GuestNotifications", fields: [recipientGuestId], references: [id])

  @@index([weddingId])
  @@index([recipientUserId])
  @@index([recipientGuestId])
  @@map("notifications")
}

model Activity {
  id           String    @id @default(uuid())
  weddingId    String    @map("wedding_id")
  actorUserId  String?   @map("actor_user_id")
  actorGuestId String?   @map("actor_guest_id")
  action       String    @db.VarChar(100)
  entityType   String    @map("entity_type") @db.VarChar(100)
  entityId     String?   @map("entity_id")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")

  wedding      Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  actorUser    User?     @relation("UserActivities", fields: [actorUserId], references: [id])
  actorGuest   Guest?    @relation("GuestActivities", fields: [actorGuestId], references: [id])

  @@index([weddingId])
  @@index([createdAt])
  @@map("activities")
}
